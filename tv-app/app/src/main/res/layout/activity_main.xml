<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_app">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp" android:layout_marginTop="24dp" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/logo_dot">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="center" android:src="@drawable/ic_play"/>
        </FrameLayout>
        <TextView style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp"
            android:text="RG TV" android:textSize="15sp"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/statusDot" style="@style/T" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="11sp" android:textColor="#FF30D158"/>
        <TextView android:id="@+id/status" style="@style/T.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:textSize="11sp" android:maxLines="1"/>
        <TextClock style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="15dp"
            android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="14sp" android:textColor="#FFE8E8EC"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="36dp" android:layout_marginEnd="36dp"
        android:layout_marginTop="84dp" android:orientation="horizontal">

    <FrameLayout android:id="@+id/tileVideos" android:layout_width="0dp" android:layout_height="165dp" android:layout_weight="1"
        android:layout_marginStart="9dp" android:layout_marginEnd="9dp" android:foreground="@drawable/focus_ring" android:focusable="true" android:clickable="true">
      <FrameLayout android:tag="clip" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tile_red" android:duplicateParentState="true">
        <View android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="top|end"
            android:layout_marginTop="-30dp" android:layout_marginEnd="-30dp" android:background="@drawable/circle_deco"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="17dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_video"/>
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Videos" android:textSize="24sp"/>
            <TextView android:id="@+id/nVideos" style="@style/T" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="#D9FFFFFF" android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>

    <FrameLayout android:id="@+id/tileMusic" android:layout_width="0dp" android:layout_height="165dp" android:layout_weight="1"
        android:layout_marginStart="9dp" android:layout_marginEnd="9dp" android:foreground="@drawable/focus_ring" android:focusable="true" android:clickable="true">
      <FrameLayout android:tag="clip" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tile_purple" android:duplicateParentState="true">
        <View android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="top|end"
            android:layout_marginTop="-30dp" android:layout_marginEnd="-30dp" android:background="@drawable/circle_deco"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="17dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_music"/>
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music" android:textSize="24sp"/>
            <TextView android:id="@+id/nMusic" style="@style/T" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="#D9FFFFFF" android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>

    <FrameLayout android:id="@+id/tilePhotos" android:layout_width="0dp" android:layout_height="165dp" android:layout_weight="1"
        android:layout_marginStart="9dp" android:layout_marginEnd="9dp" android:foreground="@drawable/focus_ring" android:focusable="true" android:clickable="true">
      <FrameLayout android:tag="clip" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tile_teal" android:duplicateParentState="true">
        <View android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="top|end"
            android:layout_marginTop="-30dp" android:layout_marginEnd="-30dp" android:background="@drawable/circle_deco"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="17dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_photo"/>
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Photos" android:textSize="24sp"/>
            <TextView android:id="@+id/nPhotos" style="@style/T" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="#D9FFFFFF" android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>

    <FrameLayout android:id="@+id/tileResume" android:layout_width="0dp" android:layout_height="165dp" android:layout_weight="1"
        android:layout_marginStart="9dp" android:layout_marginEnd="9dp" android:foreground="@drawable/focus_ring" android:focusable="true" android:clickable="true">
      <FrameLayout android:tag="clip" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tile_orange" android:duplicateParentState="true">
        <View android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="top|end"
            android:layout_marginTop="-30dp" android:layout_marginEnd="-30dp" android:background="@drawable/circle_deco"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="17dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_resume"/>
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resume" android:textSize="24sp"/>
            <TextView android:id="@+id/nResume" style="@style/T" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="#D9FFFFFF" android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>

    <FrameLayout android:id="@+id/tileTV" android:layout_width="0dp" android:layout_height="165dp" android:layout_weight="1"
        android:layout_marginStart="9dp" android:layout_marginEnd="9dp" android:foreground="@drawable/focus_ring" android:focusable="true" android:clickable="true">
      <FrameLayout android:tag="clip" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tile_tv" android:duplicateParentState="true">
        <View android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="top|end"
            android:layout_marginTop="-30dp" android:layout_marginEnd="-30dp" android:background="@drawable/circle_deco"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="17dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_tv"/>
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TV" android:textSize="24sp"/>
            <TextView android:id="@+id/nTV" style="@style/T" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="#D9FFFFFF" android:maxLines="1"/>
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="45dp" android:layout_marginTop="270dp" android:orientation="horizontal">

        <TextView android:id="@+id/chipSearch" style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:background="@drawable/chip_bg" android:drawableStart="@drawable/ic_search" android:drawablePadding="7dp"
            android:paddingStart="13dp" android:paddingEnd="15dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:gravity="center_vertical"
            android:text="Search" android:textSize="12sp" android:focusable="true" android:clickable="true"/>

        <TextView android:id="@+id/chipFolders" style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:background="@drawable/chip_bg" android:drawableStart="@drawable/ic_folder" android:drawablePadding="7dp"
            android:paddingStart="13dp" android:paddingEnd="15dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:gravity="center_vertical"
            android:text="Folders (#tags)" android:textSize="12sp" android:focusable="true" android:clickable="true"/>

        <TextView android:id="@+id/chipSettings" style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="10dp" android:background="@drawable/chip_bg" android:drawableStart="@drawable/ic_settings" android:drawablePadding="7dp"
            android:paddingStart="13dp" android:paddingEnd="15dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:gravity="center_vertical"
            android:text="Settings" android:textSize="12sp" android:focusable="true" android:clickable="true"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="45dp" android:layout_marginEnd="45dp"
        android:layout_marginTop="316dp" android:layout_marginBottom="22dp" android:background="@drawable/glass" android:orientation="vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="6dp">
        <TextView style="@style/T.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:layout_marginBottom="4dp" android:letterSpacing="0.06" android:text="NAYA AAYA" android:textSize="12sp"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recent" android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            <TextView android:id="@+id/empty" style="@style/T.Sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:textSize="13sp" android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>

    
    <TextView android:id="@+id/footer" style="@style/T.Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_marginBottom="5dp" android:gravity="center" android:text="Support &amp; Love ♥ Ravi" android:textSize="10sp" android:alpha="0.8"/>
</FrameLayout>
