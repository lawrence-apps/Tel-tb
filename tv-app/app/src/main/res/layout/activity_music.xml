<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_app">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="45dp" android:layout_marginEnd="45dp"
        android:layout_marginTop="28dp" android:layout_marginBottom="24dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="330dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical">
            <FrameLayout android:id="@+id/coverWrap" android:layout_width="232dp" android:layout_height="232dp" android:background="@drawable/cover_bg" android:outlineProvider="background">
                <ImageView android:layout_width="90dp" android:layout_height="90dp" android:layout_gravity="center" android:alpha="0.5" android:src="@drawable/ic_music"/>
                <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            </FrameLayout>
            <TextView android:id="@+id/title" style="@style/T.B" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textSize="20sp"/>
            <TextView android:id="@+id/artist" style="@style/T.Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:ellipsize="end" android:gravity="center" android:maxLines="2" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tPos" style="@style/T.Sub" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="11sp" android:text="0:00"/>
                <com.rgbotz.tv.TvSeekBar android:id="@+id/seek" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1"/>
                <TextView android:id="@+id/tDur" style="@style/T.Sub" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="11sp" android:text="0:00"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/btnShuffle" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:background="@drawable/btn_round" android:padding="9dp" android:src="@drawable/ic_shuffle" android:focusable="true" android:clickable="true"/>
                <ImageView android:id="@+id/btnPrev" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:background="@drawable/btn_round" android:padding="10dp" android:src="@drawable/ic_prev" android:focusable="true" android:clickable="true"/>
                <ImageView android:id="@+id/btnPlay" android:layout_width="54dp" android:layout_height="54dp" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:background="@drawable/btn_round_red" android:padding="13dp" android:src="@drawable/ic_play" android:focusable="true" android:clickable="true"/>
                <ImageView android:id="@+id/btnNext" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:background="@drawable/btn_round" android:padding="10dp" android:src="@drawable/ic_next" android:focusable="true" android:clickable="true"/>
                <ImageView android:id="@+id/btnRepeat" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:background="@drawable/btn_round" android:padding="9dp" android:src="@drawable/ic_repeat" android:focusable="true" android:clickable="true"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="28dp" android:layout_weight="1"
            android:background="@drawable/glass" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/listTitle" style="@style/T.Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:layout_marginBottom="4dp" android:letterSpacing="0.05" android:textSize="12sp"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/songs" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="4dp"/>
                <TextView android:id="@+id/empty" style="@style/T.Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:gravity="center" android:text="Channel me abhi koi gaana nahi" android:textSize="14sp" android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
