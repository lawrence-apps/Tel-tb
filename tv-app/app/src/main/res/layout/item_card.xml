<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="9dp"
    android:focusable="true" android:clickable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:duplicateParentState="true">
        <FrameLayout android:id="@+id/thumbWrap" android:layout_width="match_parent" android:layout_height="114dp" android:background="@drawable/card_bg"
            android:foreground="@drawable/focus_ring_card" android:duplicateParentState="true" android:outlineProvider="background">
            <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
            <TextView android:id="@+id/badgeQ" style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start"
                android:layout_margin="6dp" android:background="@drawable/badge_bg" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp"/>
            <TextView android:id="@+id/badgeS" style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end"
                android:layout_margin="6dp" android:background="@drawable/badge_bg" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp"/>
            <TextView android:id="@+id/badgeD" style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
                android:layout_margin="6dp" android:background="@drawable/badge_bg" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp"/>
            <LinearLayout android:id="@+id/prog" android:layout_width="match_parent" android:layout_height="4dp" android:layout_gravity="bottom" android:orientation="horizontal" android:visibility="gone">
                <View android:id="@+id/progFill" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5" android:background="@color/acc"/>
                <View android:id="@+id/progRest" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5" android:background="#59FFFFFF"/>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/title" style="@style/T.B" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
            android:ellipsize="end" android:maxLines="1" android:textSize="13sp"/>
        <TextView android:id="@+id/meta" style="@style/T.Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:ellipsize="end" android:maxLines="1" android:textSize="10.5sp"/>
    </LinearLayout>
</FrameLayout>
