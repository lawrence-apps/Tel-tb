<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="34dp" android:background="@drawable/row_bg"
    android:focusable="true" android:clickable="true" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginTop="1dp">
    <ImageView android:id="@+id/icon" android:layout_width="16dp" android:layout_height="16dp" android:alpha="0.7"/>
    <TextView android:id="@+id/title" style="@style/T.B" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="11dp" android:ellipsize="end" android:maxLines="1" android:textSize="13.5sp"/>
    <TextView android:id="@+id/type" style="@style/T.Sub" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="10.5sp" android:maxLines="1"/>
    <TextView android:id="@+id/size" style="@style/T.Sub" android:layout_width="70dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="10.5sp" android:maxLines="1"/>
    <TextView android:id="@+id/day" style="@style/T.Sub" android:layout_width="70dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="10.5sp" android:maxLines="1"/>
</LinearLayout>
