<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:background="@drawable/row_bg"
    android:focusable="true" android:clickable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginTop="2dp">
    <ImageView android:id="@+id/check" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_check"/>
    <TextView android:id="@+id/name" style="@style/T.B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:textSize="14sp" android:maxLines="1"/>
    <TextView android:id="@+id/info" style="@style/T.Sub" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
